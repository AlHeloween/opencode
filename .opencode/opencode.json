{
  "$schema": "https://opencode.ai/config.schema.json",
  "provider": {
    "streamlake": {
      "name": "StreamLake",
      "env": ["STREAMLAKE_API_KEY"],
      "api": "openai",
      "models": {
        "kat-coder-pro-v2": {
          "id": "kwaipilot/kat-coder-pro-v2",
          "name": "Kat Coder Pro V2",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": false,
          "baseURL": "https://vanchin.streamlake.ai/api/gateway/v1/endpoints",
          "limit": { "context": 256000, "output": 256000 },
          "cost": { "input": 0.3, "output": 1.2 },
          "gateway": {
            "rateLimit": { "tpm": 300000, "rpm": 5 },
            "logging": { "enabled": true, "format": "json" }
          }
        }
      },
      "options": {
        "timeout": 300000,
        "chunkTimeout": 30000
      }
    }
  },
  "gateway": {
    "enabled": true,
    "preferH2": false,
    "logging": {
      "enabled": true,
      "format": "json"
    }
  }
}

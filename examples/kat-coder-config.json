{
  "$schema": "https://opencode.ai/config.schema.json",
  "providers": {
    "streamlake": {
      "name": "StreamLake",
      "env": ["STREAMLAKE_API_KEY"],
      "api": "openai",
      "models": {
        "kat-coder-pro-v2": {
          "baseURL": "https://vanchin.streamlake.ai/api/gateway/v1/endpoints",
          "gateway": {
            "rateLimit": {
              "tpm": 300000,
              "rpm": 5
            },
            "logging": {
              "enabled": true,
              "format": "json"
            }
          }
        },
        "qwen3.6-plus-free": {
          "baseURL": "https://vanchin.streamlake.ai/api/gateway/v1/endpoints",
          "gateway": {
            "rateLimit": {
              "tpm": 300000,
              "rpm": 5
            },
            "logging": {
              "enabled": true,
              "format": "json"
            }
          },
          "options": {
            "headers": {
              "Authorization": "Bearer {env:STREAMLAKE_API_KEY}"
            }
          }
        }
      },
      "options": {
        "apiKey": "{env:STREAMLAKE_API_KEY}",
        "timeout": 300000,
        "chunkTimeout": 30000
      }
    }
  },
  "gateway": {
    "enabled": true,
    "preferH2": false,
    "logging": {
      "enabled": true,
      "format": "json"
    }
  }
}

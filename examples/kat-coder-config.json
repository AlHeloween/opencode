{
  "$schema": "https://opencode.ai/config.schema.json",
  "providers": {
    "models": {
      "kat-coder-pro-v2": {
        "provider": {
          "npm": "@ai-sdk/openai",
          "api": "openai"
        },
        "baseURL": "https://vanchin.streamlake.ai/api/gateway/coding/v1",
        "limit": {
          "context": 256000,
          "output": 80000
        },
        "gateway": {
          "enabled": true,
          "preferH2": false,
          "alpnProbeIntervalMs": 3600000,
          "healthWindowSize": 100,
          "rateLimit": {
            "tpm": 300000,
            "rpm": 5
          },
          "logging": {
            "enabled": true,
            "format": "json"
          }
        },
        "variants": {
          "default": {
            "gateway": {
              "logging": {
                "enabled": true
              }
            }
          }
        }
      },
      "kat-coder-pro": {
        "provider": {
          "npm": "@ai-sdk/openai",
          "api": "openai"
        },
        "baseURL": "https://vanchin.streamlake.ai/api/gateway/coding/v1",
        "limit": {
          "context": 256000,
          "output": 80000
        },
        "gateway": {
          "rateLimit": {
            "tpm": 300000,
            "rpm": 5
          },
          "logging": {
            "enabled": true,
            "format": "json"
          }
        }
      }
    },
    "options": {
      "openai": {
        "apiKey": "your-streamlake-api-key",
        "baseURL": "https://vanchin.streamlake.ai/api/gateway/coding/v1",
        "timeout": 300000,
        "chunkTimeout": 30000
      }
    }
  }
}

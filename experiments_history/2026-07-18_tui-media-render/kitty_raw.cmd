@echo off
setlocal

echo ============================================
echo   Raw Kitty Protocol Test
echo ============================================
echo.
echo If you see a red rectangle below, kitty works.
echo If not, Windows Terminal kitty protocol is not active.
echo.

:: Generate a tiny 64x64 red PNG via PowerShell, then send kitty escape
powershell -NoProfile -c ^
  "$png=[byte[]]@(0x89,0x50,0x4E,0x47,0x0D,0x0A,0x1A,0x0A,0x00,0x00,0x00,0x0D,0x49,0x48,0x44,0x52,0x00,0x00,0x00,0x20,0x00,0x00,0x00,0x20,0x08,0x02,0x00,0x00,0x00,0xFC,0x18,0xED,0xA3,0x00,0x00,0x00,0x2C,0x49,0x44,0x41,0x54,0x78,0xDA,0xED,0xD0,0x31,0x01,0x00,0x00,0x08,0x03,0xA0,0x93,0x7F,0x4D,0x6F,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x70,0x02,0x9F,0x40,0x00,0x01,0x94,0x88,0x00,0xE6,0x00,0x00,0x00,0x00,0x49,0x45,0x4E,0x44,0xAE,0x42,0x60,0x82);^
   $b64=[Convert]::ToBase64String($png);^
   Write-Host -NoNewline ([char]0x1B + '_Gf=24,f=100,t=d;' + $b64 + [char]0x1B + '\\')"

echo.
echo.
echo ============================================
echo   Result:
echo   [ ] Red rectangle visible   = kitty OK
echo   [ ] Garbled base64 text     = kitty not supported
echo   [ ] Nothing                 = escape seq swallowed
echo ============================================
echo.
pause

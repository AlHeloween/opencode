+def lineage_reason(name, check, brief, parent, own):
+    """The named reason the watcher exits with — an idle robot is always an event.
+
+    t141: the parent family names the brief md5 it expected and the parent it got; the own-md5 family
+    names the md5 that must be fresh. The family prefix `finished-lineage-` is what a reader greps."""
+    if check in ("md5==brief", "md5-reuse", "no-own-md5"):
+        return ("finished-lineage-md5: " + name + " expected a fresh own md5 got " + (own or "none")
+                + " (" + check + ")")
+    return ("finished-lineage-mismatch: " + name + " expected " + (brief or "none")
+            + " got " + (parent or "none"))
+

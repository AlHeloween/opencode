{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    // Off: @opentui/core resolves to its .ts sources (skipLibCheck does not cover them), and the
    // 0.5.11 core is written without `override` — this flag would police core, not the spinner.
    "noImplicitOverride": false,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "bench/**/*.ts",
    "profile/**/*.ts",
    "src/index.ts",
    "src/utils.ts",
    "src/react.ts",
    "tests/core/**/*.ts",
    "tests/package/**/*.ts",
    "tests/react/**/*.tsx"
  ],
  "exclude": ["dist", "tests/solid"]
}

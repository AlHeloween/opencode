{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "paths": {
      "*": ["./*"],
      "@opentui/core": ["../core/src"],
      "@opentui/core/*": ["../core/src/*"],
      "@opentui/react": ["../react/src"],
      "@opentui/react/*": ["../react/src/*"]
    }
  },
  "include": ["examples/react.tsx", "src/**/*.ts"],
  "exclude": ["dist", "src/tests", "examples/solid.tsx", "examples/solid-app.tsx"]
}

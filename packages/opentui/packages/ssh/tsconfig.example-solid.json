{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "paths": {
      "*": ["./*"],
      "@opentui/core": ["../core/src"],
      "@opentui/core/*": ["../core/src/*"],
      "@opentui/solid": ["../solid/src"],
      "@opentui/solid/*": ["../solid/src/*"]
    }
  },
  "include": ["examples/solid.tsx", "examples/solid-app.tsx", "src/**/*.ts"],
  "exclude": ["dist", "src/tests", "examples/react.tsx"]
}

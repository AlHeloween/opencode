+  const cacheKey = `${scope}:${slot}`
+  const token = ++taskCacheLeaseID
+  taskCacheLeases.set(cacheKey, token)
+  return {
+    cacheKey,
+    slot,
+    release: Effect.sync(() => {
+      if (taskCacheLeases.get(cacheKey) === token) taskCacheLeases.delete(cacheKey)
+    }),
+  }
